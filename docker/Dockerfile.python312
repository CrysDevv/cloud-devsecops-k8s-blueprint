# syntax=docker/dockerfile:1.7
# FastAPI (Python 3.12) - multi-stage endurecido.
# Contexto de build: raíz del microservicio (requirements.txt y el paquete "app/").
# Requiere: uvicorn en requirements.txt y dependencias disponibles como wheels
# (el builder no incluye compiladores a propósito).
# Uso: scripts/build-image.sh python312 <ruta-del-servicio> <imagen:tag>

ARG PYTHON_IMAGE=python:3.12.8-slim-bookworm

# ---------- Etapa 1: builder (venv aislado) ----------
FROM ${PYTHON_IMAGE} AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

COPY requirements.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt \
 && pip uninstall -y pip setuptools wheel

# ---------- Etapa 2: runtime ----------
FROM ${PYTHON_IMAGE} AS runtime

ARG APP_VERSION=0.0.0
ARG VCS_REF=unknown
ARG APP_PORT=8080

LABEL org.opencontainers.image.title="python312-service" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.description="FastAPI service on Python 3.12 (hardened)"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}" \
    APP_PORT=${APP_PORT} \
    HEALTH_PATH=/health \
    APP_MODULE=app.main:app

RUN apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends tini \
 && rm -rf /var/lib/apt/lists/* \
 && /usr/local/bin/python -m pip uninstall -y pip setuptools wheel \
 && groupadd --gid 10001 app \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin app

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=10001:10001 . /app

USER 10001:10001
EXPOSE ${APP_PORT}

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import os,sys,urllib.request as u; sys.exit(0 if u.urlopen('http://127.0.0.1:%s%s' % (os.environ['APP_PORT'], os.environ['HEALTH_PATH']), timeout=3).status == 200 else 1)"]

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "exec uvicorn \"$APP_MODULE\" --host 0.0.0.0 --port \"$APP_PORT\" --no-server-header"]
