{
  "uid": "stack-health",
  "title": "Stack Health",
  "tags": ["blueprint"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Targets up (1 = OK)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "up", "legendFormat": "{{job}} {{instance}}" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Series activas en Prometheus",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "prometheus_tsdb_head_series" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memoria de Prometheus (RSS)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{job=\"prometheus\"}", "legendFormat": "rss" }
      ]
    }
  ]
}
