# Copia generada por scripts/init-env.sh -> .env (no se versiona).
# GRAFANA_ADMIN_PASSWORD se deja vacía a propósito: init-env.sh genera una aleatoria.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Variables usadas por docker-compose.app.yml
# APP_IMAGE es obligatoria (por ejemplo: mi-servicio:dev)
APP_IMAGE=
APP_PORT=8080
APP_HOST_PORT=8080
OTEL_SERVICE_NAME=app
